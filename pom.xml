<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.dyanet.osrs</groupId>
    <artifactId>osrs-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>OpenSRS Parent Project</name>
    <description>Java client for the OpenSRS (Tucows) reseller XML API. Parent POM and BOM: import it
        (type pom, scope import) to align the versions of the com.dyanet.osrs artifacts.</description>
    <url>https://github.com/dyanet/osrs</url>
    <inceptionYear>2012</inceptionYear>

    <!-- Maven Central requires licenses, developers and scm (connection,
         developerConnection, url) in every published POM. -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>akberc</id>
            <name>Akber A. Choudhry</name>
            <organization>Dyanet Inc.</organization>
            <organizationUrl>https://dyanet.com/</organizationUrl>
        </developer>
    </developers>
    <organization>
        <name>Dyanet</name>
        <url>https://dyanet.com/</url>
    </organization>
    <scm>
        <connection>scm:git:https://github.com/dyanet/osrs.git</connection>
        <developerConnection>scm:git:https://github.com/dyanet/osrs.git</developerConnection>
        <url>https://github.com/dyanet/osrs</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/dyanet/osrs/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <slf4j.version>2.0.20</slf4j.version>
        <junit.version>5.14.4</junit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <!-- JUnit tags excluded by default; -Pintegration runs them (live horizon calls). -->
        <test.excluded.groups>integration</test.excluded.groups>
        <!-- Per-module minimum instruction coverage enforced by jacoco:check. -->
        <jacoco.coverage.minimum>0.80</jacoco.coverage.minimum>
    </properties>

    <!--
      This POM is also the BOM. dependencyManagement lists only the published com.dyanet.osrs
      artifacts and their runtime dependencies, so importing it doesn't pin a consumer's test
      libraries. Test dependencies are declared under <dependencies> below instead.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.dyanet.osrs</groupId>
                <artifactId>osrs-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dyanet.osrs</groupId>
                <artifactId>osrs-domains</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <encoding>utf-8</encoding>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${osrs.module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!--
      Published modules. Modules still being written live in the "incubating" profile below:
      CI builds and tests them (mvn -Pincubating verify), but a release (mvn -Prelease deploy)
      leaves them out, so nothing half-finished reaches Maven Central. When a module is
      complete, move it here and add it to dependencyManagement above.
    -->
    <modules>
        <module>osrs-api</module>
        <module>osrs-domains</module>
    </modules>

    <profiles>
        <profile>
            <id>incubating</id>
            <modules>
                <module>osrs-transfers</module>
                <module>osrs-dns</module>
            </modules>
        </profile>
        <!-- Run the live integration tests too: mvn verify -Pintegration -->
        <profile>
            <id>integration</id>
            <properties>
                <test.excluded.groups></test.excluded.groups>
            </properties>
        </profile>
        <!--
          Maven Central release: mvn -Prelease deploy
          Builds sources + javadoc jars, signs everything with GPG, and uploads
          one bundle to the Sonatype Central Portal. autoPublish=false leaves
          the deployment VALIDATED but unpublished until a maintainer clicks
          Publish on central.sonatype.com (Deployments), so a release is
          approved by hand, as with the npm packages.
          CI supplies: CENTRAL_TOKEN_USERNAME / CENTRAL_TOKEN_PASSWORD
          (server id "central" in settings.xml) and MAVEN_GPG_KEY /
          MAVEN_GPG_PASSPHRASE (read by the gpg plugin's BouncyCastle signer,
          so no gpg binary or keyring is needed).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <!-- Missing @param/@return tags must not fail a release. -->
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <deploymentName>osrs ${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>